---
const { education } = Astro.props;

const yearRange = education.data.endYear 
  ? `${education.data.startYear} - ${education.data.endYear}`
  : `${education.data.startYear} - Present`;

const isGraduated = education.data.endYear && education.data.endYear <= new Date().getFullYear();
---

<div class="flex flex-col md:flex-row gap-3 md:gap-6 items-start text-sm">
  <div class="flex flex-col min-w-[80px] md:min-w-[120px]">
    <time class="text-muted">{yearRange}</time>
    {isGraduated && (
      <span class="text-muted text-xs mt-1">Graduated</span>
    )}
  </div>
  
  <div class="flex-1 flex flex-col gap-1">
    <h3 class="text-foreground font-medium">
      {education.data.degree}
      {education.data.field && ` ${education.data.field}`}
      {education.data.cgpa && ` · CGPA: ${education.data.cgpa}`}
    </h3>
    
    <div class="text-muted text-xs flex flex-col md:flex-row md:flex-wrap md:gap-0">
      <span>
        {education.data.institutionUrl ? (
          <a href={education.data.institutionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
            {education.data.institution}
          </a>
        ) : (
          education.data.institution
        )}
        {education.data.location && ` · ${education.data.location}`}
      </span>
      {education.data.accreditation && (
        <span class="md:before:content-['_·_']">
          {education.data.accreditationUrl ? (
            <a href={education.data.accreditationUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
              {education.data.accreditation}
            </a>
          ) : (
            education.data.accreditation
          )}
        </span>
      )}
    </div>
  </div>

  {education.data.verifyUrl && (
    <div class="flex items-center shrink-0 md:self-start mt-2 md:mt-0">
      <a href={education.data.verifyUrl} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent transition-colors flex items-center gap-1" aria-label="Verify degree">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <span class="text-xs">Verify</span>
      </a>
    </div>
  )}
</div>
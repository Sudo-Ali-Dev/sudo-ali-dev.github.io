---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { SITE_NAME, SOCIAL_LINKS } from "../config";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string | ImageMetadata;
  article?: boolean;
  publishDate?: Date;
  updatedDate?: string;
  robots?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "/share.jpg",
  article = false,
  publishDate,
  updatedDate,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let absoluteOgImage: string;
if (typeof image === "string") {
  absoluteOgImage = new URL(image, Astro.site).href;
} else {
  const optimized = await getImage({ src: image, width: 1200 });
  absoluteOgImage = new URL(optimized.src, Astro.site).href;
}

const rssFeedUrl = new URL("/rss.xml", Astro.site).href;

const publishedTime =
  article && publishDate ? publishDate.toISOString() : undefined;

let modifiedTime: string | undefined;
if (updatedDate) {
  const t = new Date(updatedDate).getTime();
  if (!Number.isNaN(t)) {
    modifiedTime = new Date(t).toISOString();
  }
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Language and Locale -->
<meta http-equiv="content-language" content="en-US" />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — blog`} href={rssFeedUrl} />

<!-- Robots -->
<meta name="robots" content={robots} />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Theme (PWA / browser UI) -->
<meta name="theme-color" content="#f7f4ef" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_NAME} />
{SOCIAL_LINKS.map((link) => (
  <link rel="me" href={link.url} />
))}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{
  modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

{
  structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )
}

<script>
  function onKonamiCode(cb: { (): void; (): any }) {
    var input = "";
    var key = "38384040373937396665";
    document.addEventListener("keydown", function (e) {
      input += "" + e.keyCode;
      if (input === key) {
        return cb();
      }
      if (!key.indexOf(input)) return;
      input = "" + e.keyCode;
    });
  }

  onKonamiCode(function () {
    // REDIRECT TO HAPPY PATH
    window.location.href = "/happy";
  });
</script>

<ClientRouter />

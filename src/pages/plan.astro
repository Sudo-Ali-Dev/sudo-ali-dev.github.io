---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecryptText from "../components/DecryptText.astro";

---

<BaseLayout title="My 2026 Plan">

  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
      svg#mindmap {
        touch-action: none;
      }

      /* Ripple expand animation */
      @keyframes rippleExpand {
        0% { r: 5; opacity: 0.6; }
        100% { r: 50; opacity: 0; }
      }
    </style>

<div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: auto;">
  <svg id="mindmap" style="width:100%;height:100%; cursor: grab;"></svg>
</div>

  <!-- Controls -->
<div style="position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); z-index: 10; display: flex; flex-direction: row; align-items: center; gap: 0.75rem; white-space: nowrap;">
  <div id="hint" class="text-xs backdrop-blur-md px-3 py-1.5 rounded-full" style="color: var(--color-muted); background: color-mix(in srgb, var(--color-surface) 60%, transparent); border: 1px solid color-mix(in srgb, var(--color-muted) 20%, transparent);">
    Pinch · Tap
  </div>
  <button id="reset-btn"
    class="text-xs backdrop-blur-md px-3 py-1.5 rounded-full hover:opacity-80 transition-opacity"
    style="color: var(--color-secondary); background: color-mix(in srgb, var(--color-surface) 60%, transparent); border: 1px solid color-mix(in srgb, var(--color-muted) 20%, transparent);">
    ⟳ Reset
  </button>
</div>
<div class="hidden sm:block" style="position: fixed; bottom: 1.5rem; left: 1.5rem; z-index: 10;">
  <h2 class="text-sm font-bold font-mono" style="color: var(--color-primary);">
    <span style="color: var(--color-accent); font-size: 1.1rem;">&gt;_</span> <span style="font-family: Nunito, sans-serif;"><DecryptText text="Learning Roadmap" speed={60}/></span>
  </h2>
</div>

  <!-- Tooltip -->
  <div id="tooltip" style="
    position: fixed; z-index: 20; pointer-events: none;
    background: rgba(0,0,0,0.75); color: white;
    padding: 0.4rem 0.75rem; border-radius: 8px;
    font-size: 12px; font-family: Nunito, sans-serif;
    opacity: 0; transition: opacity 0.15s;
    backdrop-filter: blur(8px);
  "></div>

  <script>
    import * as d3 from 'd3';

    const COLORS = [
      '#f9b4b4', '#f9d4a0', '#a8d8a8', '#a8c8f0',
      '#c8a8f0', '#f0a8d0', '#a8e8d8', '#f0d4a8',
    ];
    const DARK_COLORS = [
      '#e07070', '#e0a850', '#60b060', '#5090d0',
      '#9060d0', '#d060a0', '#50c0a0', '#d0a060',
    ];
    // Glow-shadow colors per branch (semi-transparent for drop-shadow)
    const GLOW_COLORS = [
      'rgba(224,112,112,0.45)', 'rgba(224,168,80,0.45)', 'rgba(96,176,96,0.45)', 'rgba(80,144,208,0.45)',
      'rgba(144,96,208,0.45)', 'rgba(208,96,160,0.45)', 'rgba(80,192,160,0.45)', 'rgba(208,160,96,0.45)',
    ];

    interface NodeData { name: string; children?: NodeData[]; _children?: NodeData[]; }

    const root_data: NodeData = {
      name: 'My 2026 Plan',
      children: [
        { name: 'Python Basics', children: [
          { name: 'Syntax &\nVariables' }, { name: 'Functions &\nModules' },
          { name: 'File Handling' }, { name: 'Virtual\nEnvironments' }]},
        { name: 'Programming\nFoundations', children: [
          { name: 'OOP Basics' }, { name: 'Data Structures' },
          { name: 'Algorithms Intro' }, { name: 'Debugging Skills' }]},
        { name: 'Math for AI', children: [
          { name: 'Linear Algebra' }, { name: 'Probability' },
          { name: 'Statistics' }, { name: 'Gradient Descent' }]},
        { name: 'Machine\nLearning', children: [
          { name: 'Supervised' }, { name: 'Unsupervised' },
          { name: 'Model Training' }, { name: 'Evaluation' }]},
        { name: 'Deep Learning', children: [
          { name: 'Neural Networks' }, { name: 'CNN Basics' },
          { name: 'RNN Basics' }, { name: 'PyTorch / TF' }]},
        { name: 'LLM Basics', children: [
          { name: 'What are LLMs?' }, { name: 'Prompt\nEngineering' },
          { name: 'OpenAI APIs' }, { name: 'Fine-tuning' }]},
        { name: 'Deployment', children: [
          { name: 'FastAPI' }, { name: 'Model Serving' },
          { name: 'Docker' }, { name: 'Cloud Deploy' }]},
        { name: 'AI Projects', children: [
          { name: 'AI Chatbot' }, { name: 'Image Classifier' },
          { name: 'Text Summarizer' }, { name: 'Doc Q&A' }]},
      ]
    };

    const tooltip = document.getElementById('tooltip')!;
    const svg = d3.select<SVGSVGElement, unknown>('#mindmap');

    // Transparent rect to catch zoom and pan events in Chrome
    svg.append('rect')
      .attr('width', '100%')
      .attr('height', '100%')
      .attr('fill', 'transparent');

    let width = window.innerWidth;
    let height = window.innerHeight;

    // Defs for filters and gradients
    const defs = svg.append('defs');

    // Glow filter for hover
    defs.append('filter').attr('id', 'glow')
      .append('feGaussianBlur').attr('stdDeviation', '4').attr('result', 'blur')
      .select(function() { return this.parentNode as Element; })
      .append('feMerge').selectAll('feMergeNode')
      .data(['blur', 'SourceGraphic']).join('feMergeNode')
      .attr('in', (d: string) => d);

    // Create gradient defs for each branch link (parent → child color)
    DARK_COLORS.forEach((color, i) => {
      const grad = defs.append('linearGradient')
        .attr('id', `link-grad-${i}`)
        .attr('gradientUnits', 'userSpaceOnUse');
      grad.append('stop').attr('offset', '0%').attr('stop-color', color).attr('stop-opacity', 0.8);
      grad.append('stop').attr('offset', '100%').attr('stop-color', color).attr('stop-opacity', 0.25);
    });

    const g = svg.append('g');

    const zoomBehavior = d3.zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.25, 4])
      .on('zoom', (e: d3.D3ZoomEvent<SVGSVGElement, unknown>) =>
        g.attr('transform', e.transform.toString()));
    svg.call(zoomBehavior);

    const root = d3.hierarchy<NodeData>(root_data);
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      g.style('will-change', 'transform');
    }
    let radius = Math.min(width, height) * .6;

    const treeLayout = d3.tree<NodeData>()
      .size([2 * Math.PI, radius])
      .separation((a: any, b: any) => {
        if (a.depth === 1) return a.parent === b.parent ? 2.2 : 3.5;
        return a.parent === b.parent ? 1.2 : 2.5;
      });

    // Get branch index for color
    const getBranchIdx = (d: any): number => {
      if (d.depth === 0) return -1;
      const top = d.ancestors().find((n: any) => n.depth === 1) ?? d;
      return (root.children ?? []).indexOf(top);
    };

    const getColor = (d: any, dark = false): string => {
      if (d.depth === 0) return '#d4b8f0';
      const idx = getBranchIdx(d);
      const palette = dark ? DARK_COLORS : COLORS;
      return d.depth === 1
        ? palette[idx % palette.length]
        : palette[idx % palette.length] + (dark ? '' : 'cc');
    };

    // Ripple group sits above links but below nodes
    let linkGroup = g.append('g').attr('class', 'links');
    let rippleGroup = g.append('g').attr('class', 'ripples');
    let nodeGroup = g.append('g').attr('class', 'nodes');

    // --- Ripple effect on click ---
    function spawnRipple(x: number, y: number, color: string) {
      const ripple = rippleGroup.append('circle')
        .attr('cx', x).attr('cy', y)
        .attr('r', 5)
        .attr('fill', 'none')
        .attr('stroke', color)
        .attr('stroke-width', 2)
        .attr('opacity', 0.6);
      ripple.transition().duration(600).ease(d3.easeCubicOut)
        .attr('r', 55)
        .attr('opacity', 0)
        .attr('stroke-width', 0.5)
        .remove();
    }

    function update(animate = false) {
      treeLayout(root as any);

      // --- Links ---
      const links = linkGroup.selectAll<SVGPathElement, any>('path.link')
        .data(root.links(), (d: any) => d.target.data.name);

      const linkEnter = links.enter().append('path').attr('class', 'link')
        .attr('fill', 'none')
        .attr('stroke-opacity', 0)
        .attr('stroke-width', (d: any) => d.target.depth === 1 ? 3 : 1.8)
        .attr('stroke', (d: any) => `url(#link-grad-${getBranchIdx(d.target) % DARK_COLORS.length})`)
        .attr('stroke-linecap', 'round');

      // Animate link drawing with stroke-dasharray
      if (animate) {
        linkEnter.each(function() {
          const pathEl = this as SVGPathElement;
          // We need to set the d attribute first so getTotalLength works
          // This will be set in the merge below, but for entering links
          // we do the dash animation after merge
        });
      }

      const linkUpdate = linkEnter.merge(links as any);

      if (animate) {
        linkUpdate.transition().duration(600).ease(d3.easeCubicOut)
          .attr('stroke-opacity', 0.7)
          .attr('d', (d: any) =>
            d3.linkRadial<any, any>().angle((n: any) => n.x).radius((n: any) => n.y)(d));

        // Animate newly entering links with stroke-dasharray draw-in
        linkEnter
          .attr('d', (d: any) =>
            d3.linkRadial<any, any>().angle((n: any) => n.x).radius((n: any) => n.y)(d))
          .attr('stroke-opacity', 0.7)
          .each(function() {
            const pathEl = this as SVGPathElement;
            const len = pathEl.getTotalLength();
            d3.select(pathEl)
              .attr('stroke-dasharray', `${len} ${len}`)
              .attr('stroke-dashoffset', len)
              .transition().duration(700).ease(d3.easeCubicOut)
              .attr('stroke-dashoffset', 0)
              .on('end', function() {
                d3.select(this).attr('stroke-dasharray', null).attr('stroke-dashoffset', null);
              });
          });
      } else {
        linkUpdate
          .attr('stroke-opacity', 0.7)
          .attr('d', (d: any) =>
            d3.linkRadial<any, any>().angle((n: any) => n.x).radius((n: any) => n.y)(d));
      }

      links.exit().transition().duration(400).attr('stroke-opacity', 0).remove();

      // --- Nodes ---
      const nodes = nodeGroup.selectAll<SVGGElement, any>('g.node')
        .data(root.descendants(), (d: any) => d.data.name);

      const nodeEnter = nodes.enter().append('g').attr('class', 'node')
        .attr('transform', (d: any) => `translate(${d3.pointRadial(d.x, d.y)})`)
        .style('opacity', 0)
        .style('cursor', (d: any) => d.depth > 0 && d.depth < 2 ? 'pointer' : 'default');

      // Build each node
      nodeEnter.each(function(d: any) {
        const el = d3.select<SVGGElement, any>(this);
        const lines: string[] = d.data.name.split('\n');
        const isRoot = d.depth === 0;
        const isBranch = d.depth === 1;
        const isLeaf = d.depth === 2;
        const w = isRoot ? 120 : isBranch ? 128 : 118;
        const h = isRoot ? 58 : lines.length > 1 ? 50 : 36;
        const branchIdx = getBranchIdx(d);

        // Shadow rect — lightweight alternative to SVG filters
        if (!isMobile) {
          el.append('rect')
            .attr('x', -w / 2 + 2).attr('y', -h / 2 + 3)
            .attr('width', w).attr('height', h)
            .attr('rx', 14).attr('ry', 14)
            .attr('fill', 'rgba(0,0,0,0.12)');
        }

        // Main rect — glassmorphism look via opacity
        el.append('rect').attr('class', 'node-rect')
          .attr('x', -w / 2).attr('y', -h / 2)
          .attr('width', w).attr('height', h)
          .attr('rx', 14).attr('ry', 14)
          .attr('fill', getColor(d))
          .attr('fill-opacity', isRoot ? 0.92 : isBranch ? 0.85 : 0.75)
          .attr('stroke', 'rgba(255,255,255,0.55)')
          .attr('stroke-width', isRoot ? 2.5 : 1.5);

        // Inner highlight — top edge gleam for glass effect
        if (!isMobile) {
          el.append('rect')
            .attr('x', -w / 2 + 4).attr('y', -h / 2 + 1)
            .attr('width', w - 8).attr('height', h * 0.35)
            .attr('rx', 12).attr('ry', 12)
            .attr('fill', 'rgba(255,255,255,0.20)')
            .attr('pointer-events', 'none');
        }


        lines.forEach((line: string, i: number) => {
          el.append('text')
            .attr('text-anchor', 'middle')
            .attr('dominant-baseline', 'middle')
            .attr('y', lines.length > 1 ? (i === 0 ? -9 : 9) : 0)
            .attr('font-size', isRoot ? 14 : isBranch ? 12 : 11)
            .attr('font-weight', isRoot ? 800 : isBranch ? 700 : 500)
            .attr('font-family', 'Nunito, system-ui, sans-serif')
            .attr('fill', '#2a2a2a')
            .attr('pointer-events', 'none')
            .text(line);
        });

        // Collapse indicator dot for branch nodes
        if (isBranch) {
          el.append('circle').attr('class', 'collapse-dot')
            .attr('cx', w / 2 - 2).attr('cy', -h / 2 + 2)
            .attr('r', 5)
            .attr('fill', DARK_COLORS[branchIdx % DARK_COLORS.length])
            .attr('stroke', 'white').attr('stroke-width', 1.5);
        }
      });

      // Hover
      nodeEnter
        .on('mouseover', function(event: MouseEvent, d: any) {
          d3.select<SVGGElement, any>(this).raise();
          d3.select<SVGGElement, any>(this).select('.node-rect')
            .transition().duration(150)
            .attr('fill-opacity', 1)
            .attr('stroke', 'rgba(255,255,255,0.9)')
            .attr('stroke-width', 2.5)
            .attr('transform', 'scale(1.12)');
          d3.select<SVGGElement, any>(this).selectAll('text')
            .transition().duration(150).attr('transform', 'scale(1.12)');
          if (!isMobile) {
            tooltip.style.opacity = '1';
            tooltip.textContent = d.data.name.replace('\n', ' ');
          }
        })
          .on('mousemove', (event: MouseEvent) => {
            if (isMobile) return;
            tooltip.style.left = (event.clientX + 14) + 'px';
            tooltip.style.top = (event.clientY - 10) + 'px';
          })
        .on('mouseout', function() {
          const d: any = d3.select<SVGGElement, any>(this).datum();
          const isRoot = d.depth === 0;
          const isBranch = d.depth === 1;
          d3.select<SVGGElement, any>(this).select('.node-rect')
            .transition().duration(250)
            .attr('fill-opacity', isRoot ? 0.92 : isBranch ? 0.85 : 0.75)
            .attr('stroke', 'rgba(255,255,255,0.55)')
            .attr('stroke-width', isRoot ? 2.5 : 1.5)
            .attr('transform', null);
          d3.select<SVGGElement, any>(this).selectAll('text')
            .transition().duration(250).attr('transform', null);
            if (!isMobile) tooltip.style.opacity = '0';
        })
        // Click to collapse/expand branch + ripple
        .on('click', function(_: any, d: any) {
          if (d.depth !== 1) return;
          // Spawn ripple at node position
          const [nx, ny] = d3.pointRadial(d.x, d.y);
          const color = DARK_COLORS[getBranchIdx(d) % DARK_COLORS.length];
          spawnRipple(nx, ny, color);

          if (d.children) {
            (d as any)._children = d.children;
            d.children = undefined;
          } else if ((d as any)._children) {
            d.children = (d as any)._children;
            (d as any)._children = undefined;
          }
          update(true);
        })
        // Touch fallback for real mobile
        .on('touchend', function(event: TouchEvent, d: any) {
          if (d.depth !== 1) return;
          event.stopPropagation();
          event.preventDefault();
          const [nx, ny] = d3.pointRadial(d.x, d.y);
          const color = DARK_COLORS[getBranchIdx(d) % DARK_COLORS.length];
          spawnRipple(nx, ny, color);

          if (d.children) {
            (d as any)._children = d.children;
            d.children = undefined;
          } else if ((d as any)._children) {
            d.children = (d as any)._children;
            (d as any)._children = undefined;
          }
          update(true);
        });

      // Animate nodes into position
      const nodeUpdate = nodeEnter.merge(nodes as any);
      (animate ? (nodeUpdate.transition().duration(600).ease(d3.easeCubicOut) as any) : (nodeUpdate as any))
        .attr('transform', (d: any) => `translate(${d3.pointRadial(d.x, d.y)})`)
        .style('opacity', 1);

      nodes.exit().transition().duration(400).style('opacity', 0).remove();
    }


// Auto-collapse all branches on mobile
if (isMobile) {
  root.children?.forEach((d: any) => {
    (d as any)._children = d.children;
    d.children = undefined;
  });
}

// Zoom out more on mobile so all 8 nodes fit
const mobileScale = isMobile ? 0.6 : .8;
g.attr('transform', `translate(${width / 2}, ${height / 2})`);
svg.call(
  zoomBehavior.transform,
  d3.zoomIdentity.translate(width / 2, height / 2).scale(mobileScale)
);
update(false);

// Update hint for desktop
if (!isMobile) {
  const hint = document.getElementById('hint');
  if (hint) hint.textContent = 'Scroll · Drag · Click';
}

    // Staggered entrance animation with scale bounce
    nodeGroup.selectAll<SVGGElement, any>('g.node')
      .style('opacity', 0)
      .attr('transform', (d: any) => {
        const [x, y] = d3.pointRadial(d.x, d.y);
        return `translate(${x}, ${y}) scale(0.3)`;
      })
      .transition().duration(700)
      .delay((_: any, i: number) => i * 40)
      .ease(d3.easeBackOut.overshoot(1.4))
      .style('opacity', 1)
      .attr('transform', (d: any) => `translate(${d3.pointRadial(d.x, d.y)})`);

    // Staggered link draw-in on initial load
    linkGroup.selectAll<SVGPathElement, any>('path.link')
      .each(function(d: any, i: number) {
        const pathEl = this as SVGPathElement;
        const len = pathEl.getTotalLength();
        d3.select(pathEl)
          .attr('stroke-dasharray', `${len} ${len}`)
          .attr('stroke-dashoffset', len)
          .transition().duration(800)
          .delay(i * 35)
          .ease(d3.easeCubicOut)
          .attr('stroke-dashoffset', 0)
          .on('end', function() {
            d3.select(this).attr('stroke-dasharray', null).attr('stroke-dashoffset', null);
          });
      });

    // Reset button
      document.getElementById('reset-btn')!.addEventListener('click', () => {
        svg.transition().duration(600).ease(d3.easeCubicOut)
          .call(zoomBehavior.transform, d3.zoomIdentity.translate(width / 2, height / 2).scale(mobileScale));
      });

document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && isMobile) {
    document.getElementById('reset-btn')!.click();
  }
});
  </script>

</BaseLayout>
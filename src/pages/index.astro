---
import { getCollection } from "astro:content";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import MatrixBackground from "../components/MatrixBackground.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Card from "../components/ui/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";
import TerminalHeader from "../components/ui/TerminalHeader.astro";
import TerminalPrompt from "../components/ui/TerminalPrompt.astro";
import InfoRow from "../components/ui/InfoRow.astro";
import ExternalLink from "../components/ui/ExternalLink.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Divider from "../components/ui/Divider.astro";
import PostList from "../components/ui/PostList.astro";
import EducationList from "../components/ui/EducationList.astro";
import DecryptText from "../components/DecryptText.astro";


const MAX_POSTS = 10;
const allPosts = await getCollection("blog");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const allEducation = await getCollection("education");
const allEducationByDate = allEducation.sort((a, b) => b.data.startYear - a.data.startYear);

const techStack: Record<string, string> = {
python: "python — my go-to",
c: "c — it hurts",
cpp: "c++ — it still hurts",
git: "git — push and hope",
astro: "astro — built this with it",
node: "node — barely counts",
html: "html/css — obviously",
"claude-code": "claude code — my unpaid intern",
gcp: "gcp — cloud stuff, I figure it out",
wordpress: "wordpress — did this for a year",
woocommerce: "woocommerce — never again",
shopify: "shopify — never again x2",
};

const projects: Array<{
  title: string;
  description: string;
  link: string;
  icon: string;
}> = [
  {
    title: "todo-cli",
    description: "Command-line todo manager using JSON for storage, built with Python.",
    link: "https://github.com/Sudo-Ali-Dev/todo-cli",
    icon: ">_",
  },
  {
    title: "GitTracker",
    description: "A simple CLI tool that fetches and displays the recent activity of any GitHub user using the GitHub API.",
    icon: "🛰️",
    link: "https://github.com/Sudo-Ali-Dev/GitTracker",
  },
];
---

<BaseLayout navbarActiveItemID="home">
  <MatrixBackground
    slot="background"
    highlightColor="rgba(222, 133, 74, 0.2)"
    boxSize={40}
    movementSpeed={0.1}
    movementDirection="up-left"
  />
  <main>
    <section id="about" aria-labelledby="about-heading">
      <Card role="region">
        <TerminalHeader title="terminal - ssh guest@sudo-ali.dev" />

        <!-- Content -->
        <div class="text-xs">
          <div class="space-y-4 sm:space-y-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex flex-col gap-1">
                <h1 class="text-2xl">
                  Hey, I'm <span class="text-primary font-medium">
                    <DecryptText  text="Muhammad Ali" speed={40}/>
                  </span>
                </h1>
                <p class="text-muted text-xs">
                  I’m an engineer who builds things for the web.
                </p>
              </div>
            </div>

            <!-- Personal paragraph -->
            <div class="bg-gray-200/50 dark:bg-gray-500/10 rounded-lg p-3 mb-4">
              <p class="text-primary leading-relaxed">
                Every developer has an origin story. Mine began when a semicolon ruined my entire weekend. Since then, I’ve dedicated my life to revenge — by becoming an entry-level software developer.
              </p>
            </div>

            <Divider class="mb-2" />

            <InfoRow label="location">the internet 🛜</InfoRow>

            <InfoRow label="main hobby"> learning computers… before they learn me </InfoRow>

            <InfoRow label="current focus">
              <ExternalLink
                href="/plan"
                label="One, Big, Beautiful Bill (My Edition)"
              >
                One, Big, Beautiful Bill (My Edition)
              </ExternalLink>
            </InfoRow>

            <InfoRow label="main interests">
              machine learning, coding, claude, cognition
            </InfoRow>

            <InfoRow label="contact">
              <a
                class="text-accent hover:underline focus:outline-none"
                href="mailto:aliisreceiving@gmail.com"
                aria-label="Send email to site author">aliisreceiving@gmail.com</a
              >
            </InfoRow>

            <InfoRow label="social">
              <SocialMediaIcons />
            </InfoRow>

            <div class="pt-2">
              <div class="flex flex-col sm:flex-row gap-0.5 sm:gap-0">
                <span class="text-muted sm:w-36 shrink-0">tech stack</span>
                <div
                  class="flex flex-wrap gap-2"
                  role="list"
                  aria-label="Tech stack"
                >
                  {
                    Object.keys(techStack).map((lang) => (
                      <span
                        class="tooltip text-secondary hover:text-accent transition-colors"
                        data-tooltip={techStack[lang]}
                      >
                        {lang}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <TerminalPrompt command="cat about.txt" />
      </Card>
    </section>

    <section id="projects" class="mt-2">
      <Card class="text-secondary" role="region" aria-label="Project showcase">
        <SectionHeading>   <span class="text-accent">&lt;/&gt;</span> <DecryptText  text=" my projects" speed={40} /></SectionHeading>
        <div class="space-y-2" role="list">
          {
            projects.map((project, index) => (
              <ProjectItem
                title={project.title}
                description={project.description}
                link={project.link}
                icon={project.icon}
                index={index}
              />
            ))
          }
        </div>
        <TerminalPrompt
          command={`ls -la projects/ | total ${projects.length}`}
        />
      </Card>
    </section>

    {
      allPosts.length > 0 && (
        <section id="blog" class="mt-2">
          <Card>
            <SectionHeading>✍️<DecryptText  text=" 3 am thoughts" speed={40} /></SectionHeading>
            <PostList posts={allPostsByDate} />
            <TerminalPrompt
              command={`tail -n ${allPostsByDate.length} blog/`}
            />
          </Card>
        </section>
      )
    }

    {
      allEducation.length > 0 && (
        <section id="education" class="mt-2">
          <Card>
            <SectionHeading>🎓<DecryptText  text=" education" speed={40} /></SectionHeading>
            <EducationList education={allEducationByDate} />
            <TerminalPrompt
              command={`cat education.txt | total ${allEducation.length}`}
            />
          </Card>
        </section>
      )
    }
  </main>
</BaseLayout>
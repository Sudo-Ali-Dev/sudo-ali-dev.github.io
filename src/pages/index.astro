---
import { getCollection } from "astro:content";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import MatrixBackground from "../components/MatrixBackground.astro";
import ProjectItem from "../components/ProjectItem.astro";
import Card from "../components/ui/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortMDByDate } from "../utils";
import TerminalHeader from "../components/ui/TerminalHeader.astro";
import TerminalPrompt from "../components/ui/TerminalPrompt.astro";
import InfoRow from "../components/ui/InfoRow.astro";
import ExternalLink from "../components/ui/ExternalLink.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Divider from "../components/ui/Divider.astro";
import PostList from "../components/ui/PostList.astro";
import EducationList from "../components/ui/EducationList.astro";
import DecryptText from "../components/DecryptText.astro";
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_URL,
  SOCIAL_LINKS,
  sitePageTitle,
} from "../config";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_DESCRIPTION,
    },
    {
      "@type": "Person",
      name: SITE_NAME,
      url: SITE_URL,
      sameAs: SOCIAL_LINKS.map((l) => l.url),
    },
  ],
};

const MAX_POSTS = 3;
const allPosts = await getCollection("blog");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const allEducation = await getCollection("education");
const allEducationByDate = allEducation.sort((a, b) => b.data.startYear - a.data.startYear);

const techStack: Record<string, string> = {
python: "python — my comfort language",
tensorflow: "tensorflow — fighting shapes daily",
pytorch: "pytorch — research paper speedrun",
scikitlearn: "scikit-learn — classic and reliable",
fastapi: "fastapi — APIs at lightspeed",
rag: "rag — giving LLMs memory",
lora: "lora/qlora — making GPUs suffer less",
prompt: "prompt engineering — professionally talking to AI",
docker: "docker — works on my container",
aws: "aws — clicking random services confidently",
};

const projects: Array<{
  title: string;
  description: string;
  link: string;
  icon?: string;
  logoSrc?: string;
  logoAlt?: string;
}> = [
  {
    title: "Portfolio Website & Know Me AI",
    description: "A personal portfolio with an interactive mindmap, D3.js visualizations, and Know Me — an AI chatbot with a custom RAG-lite pipeline powered by Llama 3.3 70B via Groq API.",
    link: "https://sudoali.dev",
    icon: ">_",
  },
  {
    title: "Rankistan",
    description: "The definitive index of Pakistani open source developers, auto-updated daily via GitHub Actions with AI-powered summaries, an interactive map, and ranked leaderboard.",
    logoSrc: "/logos/rankistan.svg",
    logoAlt: "Rankistan logo",
    link: "https://rankistan.dev",
  },
  {
    title: "Mehngai Monitor",
    description: "Mehngai Monitor is a data pipeline and web dashboard that scrapes official Lahore government rate sheets daily, extracts structured commodity prices via the Gemini API, and serves them through a clean analytics interface.",
    logoSrc: "/logos/mehngai-monitor.svg",
    logoAlt: "Mehngai Monitor logo",
    link: "https://mehngai.duckdns.org",
  },
];
---

<BaseLayout
  navbarActiveItemID="home"
  title={sitePageTitle("Portfolio")}
  structuredData={structuredData}
>
  <MatrixBackground
    slot="background"
    highlightColor="rgba(222, 133, 74, 0.2)"
    boxSize={40}
    movementSpeed={0.1}
    movementDirection="up-left"
  />
  <main>
    <section id="about" aria-labelledby="about-heading">
      <Card role="region">
        <TerminalHeader title="terminal - ssh guest@sudo-ali.dev" />

        <!-- Content -->
        <div class="text-xs">
          <div class="space-y-4 sm:space-y-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex flex-col gap-1">
                <h1 class="text-2xl">
                  Hey, I'm <span class="text-primary font-medium">
                    <DecryptText  text="Muhammad Ali" speed={40}/>
                  </span>
                </h1>
                <p class="text-muted text-xs">
                  I’m an engineer who builds things for the web.
                </p>
              </div>
            </div>

            <!-- Personal paragraph -->
            <div class="bg-gray-200/50 dark:bg-gray-500/10 rounded-lg p-3 mb-4">
              <p class="text-primary leading-relaxed">
                Every developer has an origin story. Mine began when a semicolon ruined my entire weekend. Since then, I’ve dedicated my life to revenge — by becoming an entry-level software developer.
              </p>
            </div>

            <Divider class="mb-2" />

            <InfoRow label="location">the internet 🛜</InfoRow>

            <InfoRow label="main hobby"> learning computers… before they learn me </InfoRow>

            <InfoRow label="current focus">
              <ExternalLink
                href="/plan"
                label="One, Big, Beautiful Bill (My Edition)"
              >
                One, Big, Beautiful Bill (My Edition)
              </ExternalLink>
            </InfoRow>

            <InfoRow label="main interests">
              machine learning, coding, claude, cognition
            </InfoRow>

            <InfoRow label="contact">
              <a
                class="text-accent hover:underline focus:outline-none"
                href="mailto:aliisreceiving@gmail.com"
                aria-label="Send email to site author">aliisreceiving@gmail.com</a
              >
            </InfoRow>

            <InfoRow label="social">
              <SocialMediaIcons />
            </InfoRow>

            <div class="pt-2">
              <div class="flex flex-col sm:flex-row gap-0.5 sm:gap-0">
                <span class="text-muted sm:w-36 shrink-0">tech stack</span>
                <div
                  class="flex flex-wrap gap-2"
                  role="list"
                  aria-label="Tech stack"
                >
                  {
                    Object.keys(techStack).map((lang) => (
                      <span
                        class="tooltip text-secondary hover:text-accent transition-colors"
                        data-tooltip={techStack[lang]}
                      >
                        {lang}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <TerminalPrompt command="cat about.txt" />
      </Card>
    </section>

    <section id="projects" class="mt-2">
      <Card class="text-secondary" role="region" aria-label="Project showcase">
        <SectionHeading>   <span class="text-accent">&lt;/&gt;</span> <DecryptText  text=" my projects" speed={40} /></SectionHeading>
        <div class="space-y-2" role="list">
          {
            projects.map((project, index) => (
              <ProjectItem
                title={project.title}
                description={project.description}
                link={project.link}
                icon={project.icon}
                logoSrc={project.logoSrc}
                logoAlt={project.logoAlt}
                index={index}
              />
            ))
          }
        </div>
        <TerminalPrompt
          command={`ls -la projects/ | total ${projects.length}`}
        />
      </Card>
    </section>

{
  allPosts.length > 0 && (
    <section id="blog" class="mt-2">
      <Card>
        <SectionHeading>✍️<DecryptText text=" 3 am thoughts" speed={40} /></SectionHeading>
        <PostList posts={allPostsByDate} />
        <div class="mt-3 pt-2 border-t border-gray-300 dark:border-gray-700 text-muted text-xs flex items-center justify-between">
          <span><span class="text-secondary">$</span> {`tail -n ${allPostsByDate.length} blog/`}</span>
          <a href="/blog" class="relative text-secondary hover:text-accent transition-all duration-200  hover:scale-105 inline-flex items-center gap-1.5 group">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
            see more thoughts
            <svg class="opacity-0 group-hover:opacity-100 transition-opacity duration-200" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
              <span class="hidden sm:block pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 opacity-0 sm:group-hover:opacity-100 transition-opacity duration-200 bg-primary text-background text-xs px-2.5 py-1.5 rounded-md whitespace-nowrap z-50">
                <DecryptText text="My trail of thoughts and moments." speed={40} trigger="hover" autoRepeat={false}/>
              </span>
          </a>
        </div>
      </Card>
    </section>
  )
}
    {
      allEducation.length > 0 && (
        <section id="education" class="mt-2">
          <Card>
            <SectionHeading>🎓<DecryptText text=" education" speed={40} /></SectionHeading>
            <EducationList education={allEducationByDate} />
          <div class="relative">
            <TerminalPrompt
              command={`cat education.txt | total ${allEducation.length}`}
            />
            {allEducationByDate[0]?.data.verifyUrl && (
              <a href={allEducationByDate[0].data.verifyUrl} target="_blank" rel="noopener noreferrer" class="md:hidden absolute right-0 bottom-0 inline-flex items-center gap-1 hover:text-accent transition-all hover:scale-110 origin-right text-xs" aria-label="Verify degree">
                <svg class="w-3 h-3 !text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
                <span><DecryptText text = "Verify" />&nbsp;&nbsp;</span>
              </a>
            )}
          </div>
          </Card>
        </section>
      )
    }
  </main>
</BaseLayout>
---
import { getCollection } from "astro:content";
import Card from "../components/ui/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalPrompt from "../components/ui/TerminalPrompt.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ProjectList from "../components/ui/ProjectList.astro";
import DecryptText from "../components/DecryptText.astro";

const allProjects = await getCollection("projects");
const allProjectsByDate = allProjects.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Archive" navbarActiveItemID="archive">
  <section aria-label="Projects">
    <Card>
      <SectionHeading as="h1">
        📦 <DecryptText text="Archive" speed={40} />
      </SectionHeading>

      {
        allProjectsByDate.length === 0 ? (
          <div class="flex items-center gap-4 mb-6">
            <p class="text-4xl">🔍</p>
            <div class="flex flex-col">
              <h1 class="text-yellow-400 text-2xl font-bold">404</h1>
              <p class="text-muted text-xs">No available projects</p>
            </div>
          </div>
        ) : (
          <ProjectList projects={allProjectsByDate} />
        )
      }

      <TerminalPrompt
        command={`ls -la archive/ | total ${allProjectsByDate.length}`}
      />
    </Card>
  </section>
</BaseLayout>
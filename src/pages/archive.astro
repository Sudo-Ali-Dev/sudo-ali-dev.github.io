---
import { getCollection } from "astro:content";
import Card from "../components/ui/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalPrompt from "../components/ui/TerminalPrompt.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ProjectList from "../components/ui/ProjectList.astro";
import DecryptText from "../components/DecryptText.astro";
import { sitePageTitle } from "../config";

const allProjects = await getCollection("projects");
const preferredOrder = [
  "Portfolio Website & Know Me AI",
  "Rankistan",
  "Mehngai Monitor",
  "HypoSnitch",
  "My 2026",
  "GitTracker",
];

const orderIndex = new Map(preferredOrder.map((title, index) => [title, index]));

const allProjectsByDate = allProjects.sort((a, b) => {
  const aIndex = orderIndex.get(a.data.title);
  const bIndex = orderIndex.get(b.data.title);

  if (aIndex !== undefined || bIndex !== undefined) {
    if (aIndex === undefined) return 1;
    if (bIndex === undefined) return -1;
    return aIndex - bIndex;
  }

  return b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title={sitePageTitle("Archive")}
  description="Selected projects — Rankistan, Mehngai Monitor, GitTracker, and more."
  navbarActiveItemID="archive"
>
  <section aria-label="Projects">
    <Card>
      <SectionHeading as="h1">
        📦 <DecryptText text="Archive" speed={40} />
      </SectionHeading>

      {
        allProjectsByDate.length === 0 ? (
          <div class="flex items-center gap-4 mb-6">
            <p class="text-4xl">🔍</p>
            <div class="flex flex-col">
              <h1 class="text-yellow-400 text-2xl font-bold">404</h1>
              <p class="text-muted text-xs">No available projects</p>
            </div>
          </div>
        ) : (
          <ProjectList projects={allProjectsByDate} />
        )
      }

      <TerminalPrompt
        command={`ls -la archive/ | total ${allProjectsByDate.length}`}
      />
    </Card>
  </section>
</BaseLayout>